# ─────────────────────────────────────────────────────────────
# Orizon Agents — Backend env (FastAPI + Agno + OpenAI + Stellar)
# ─────────────────────────────────────────────────────────────
# Copy to `.env` and fill OPENAI_API_KEY. Everything else has
# sensible defaults for local dev.

# ── OpenAI (required) ─────────────────────────────────────────
OPENAI_API_KEY=sk-...
ORCHESTRATOR_MODEL=gpt-5.3-codex
WORKER_MODEL=gpt-5.3-codex
# Code-worker tuning (optional).
CODE_REASONING_EFFORT=high
CODE_TEMPERATURE=0.3
# LLM call budgets (optional): per-request HTTP timeout handed to the
# OpenAI client, and the end-to-end decompose budget (504 on breach).
LLM_TIMEOUT_SECONDS=120
DECOMPOSE_TIMEOUT_SECONDS=90

# ── Claude + jev (orchestrator v2, optional) ─────────────────
# With ANTHROPIC_API_KEY set the orchestrator plans and works on Claude
# (ORCHESTRATOR_PROVIDER=auto); anthropic/openai force one. Without
# TYPESAFE_API_KEY the intent guard falls back to Claude Haiku 4.5. Leave
# both EMPTY when running the tests: the suite never dials either service.
ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
ORCHESTRATOR_PROVIDER=auto
# One exact Claude id per tier (planner = complex, prompt improver =
# moderate, fallback guard = low).
CLAUDE_MODEL_LOW=claude-haiku-4-5
CLAUDE_MODEL_MODERATE=claude-sonnet-5-5
CLAUDE_MODEL_COMPLEX=claude-opus-5-5
# Per-attempt HTTP bound and SDK retries for a Claude call.
CLAUDE_TIMEOUT_SECONDS=120
CLAUDE_MAX_RETRIES=2
# Server-side refusal fallbacks (beta) on Opus 5.5 / Sonnet 5.5.
CLAUDE_SERVER_FALLBACKS=true
# The pinned jev model, and jev's whole retry budget per question set.
TYPESAFE_MODEL=jev-1.13.0
JEV_TIMEOUT_SECONDS=8
JEV_MAX_RETRIES=2
# Daily AI spend ceiling in USD per UTC day; at the cap AI planning pauses
# (curated demo kits still run). 0 pauses it outright.
LLM_DAILY_SPEND_CAP_USD=10

# ── Storage ──────────────────────────────────────────────────
# Postgres DSN. With it, settlements, disputes and operator-endpoint bindings
# are durable; without it all three live in an in-memory store that is lost on
# every restart — fine for local dev and the test suite, not for anything that
# adjudicates a dispute. The store implementation is selected from this value
# alone, so there is nothing else to switch. Leave it EMPTY when running the
# tests: a DSN here makes them dial a real database.
DATABASE_URL=

# ── API hardening (optional) ─────────────────────────────────
# When set, /api/stellar/server/* require a matching X-API-Key header.
# /server/seal and the dispute adjudication routes refuse while it is unset.
API_KEY=
# Require the per-task read token (minted at execute) on task/trace reads.
# Leave false for the public demo — everything stays open.
TASK_AUTH_REQUIRED=false
# Request budget (sliding 60s window) per client, as security.client_identity
# resolves one — see the README's "Rate limiting and who the client is".
RATE_LIMIT_PER_MINUTE=1200
# Trailing X-Forwarded-For entries the ACCESS LOG's client= skips. The rate
# limiters do not read it; 0 is right behind Render.
TRUSTED_PROXY_HOPS=0
# Shared secret our frontend's server sends as X-Frontend-Proxy-Token, so its
# X-Orizon-Client-Ip names the visitor for rate limiting. At least 32 random
# characters; set the same value on Vercel. Unset trusts nobody.
FRONTEND_PROXY_TOKEN=
# /api/stellar/server/seal fails closed while API_KEY is unset. A local or CI
# testnet run may set this to keep it open; refused on mainnet.
ALLOW_KEYLESS_SERVER_SEAL=false
# How many raw forwarded chains to log after boot, to determine the hop count.
FORWARDED_CHAIN_SAMPLES=5
# Ceiling on concurrently running workflows; overflow gets 503.
ORCHESTRATOR_MAX_CONCURRENT=8
# Ceiling on concurrent free-form decompose LLM calls (kit plans are never
# gated); overflow queues within DECOMPOSE_TIMEOUT_SECONDS, then 504.
DECOMPOSE_MAX_CONCURRENT=8
# Server-side ceiling for a single PaymentEscrow.charge, in USDC.
MAX_CHARGE_USDC=100

# ── Reputation (Bayesian smoothing + routing floor) ──────────
# Master switch for on-chain rep reads + settler rating submission.
REPUTATION_ENABLED=true
# Prior mean, in bps of the 0–100 rating scale (7000 = a 3.5/5 score).
REPUTATION_PRIOR_BPS=7000
# Evidence mass of the prior, in USDC of settled work.
REPUTATION_PRIOR_WEIGHT_USDC=12
# Routing floor applied to the smoothed lower bound at decompose time.
REPUTATION_FLOOR_BPS=5500
# TTL for cached on-chain rep_state reads (per agent), in seconds.
REPUTATION_READ_TTL_SECONDS=15
# Per-rating weight cap in USDC — one whale job can't own the score.
REPUTATION_MAX_RATING_WEIGHT_USDC=100

# ── Disputes (story 4.02) ────────────────────────────────────
# How long after a paid workflow settles its buyer may dispute a step. The
# window is stamped on the settlement record, so changing this only affects
# workflows that settle afterwards.
DISPUTE_WINDOW_SECONDS=86400
# Share of the disputed step's charge credited back when a dispute is upheld.
DISPUTE_CREDITED_FRACTION=1.0
# The refund path is OFF until this is true. Turning it on makes API_KEY
# mandatory on every network, because an upheld dispute pays out of the
# platform's own wallet on an adjudicator's say-so.
DISPUTE_REFUNDS_ENABLED=false
# Ceiling on a single refund, checked before anything is signed. Separate from
# MAX_CHARGE_USDC on purpose: that bounds a buyer's own spend, this bounds ours.
MAX_REFUND_USDC=1.0
# The sweep that settles refunds stuck in `crediting` by asking the chain what
# became of each recorded transfer (docs/disputes.md). It signs nothing, and it
# starts only when DISPUTE_REFUNDS_ENABLED is also true.
REFUND_RECONCILE_ENABLED=false
# Seconds between passes, 30 to 3600. Keep it well inside the RPC's history
# window (about seven days on SDF testnet), or a stuck refund outlives it.
REFUND_RECONCILE_INTERVAL_SECONDS=120

# ── HTTP server ──────────────────────────────────────────────
# Comma-separated. In prod, set to your production domains (e.g. https://orizons.xyz + the Vercel URL).
CORS_ORIGINS=http://localhost:3000
# Render/Fly/Cloud Run inject $PORT at runtime. Leave 8000 for local.
PORT=8000
# Serve the interactive API docs (/docs, /redoc, /openapi.json).
DOCS_ENABLED=true

# ── Stellar (testnet) ────────────────────────────────────────
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ── Mainnet (production) — uncomment to switch networks ─────
# STELLAR_NETWORK=mainnet
# STELLAR_RPC_URL=https://mainnet.sorobanrpc.com
# STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
# STELLAR_AGENT_REGISTRY=CBTJ3BXTMTA2PQLRTSAZHEWQRTBMNHYCOKY5WOIYAH36LT4HTN63LTD4
# STELLAR_REPUTATION_LEDGER=CDFWQJY72GPH7PEQVFGBDZESZNVRF6LQLVWU42CFMWPGRME5RWN5AXSX
# STELLAR_PAYMENT_ESCROW=CBJCQBA47Q3EQ7HC46GAWJPVM7KMD5KAEI5KG4FPYJFKR3NYB4QR5CNF
# STELLAR_ATTESTATION_REGISTRY=CBLV6QGFCMXBXHT62JZ7YH22NXW7MVBGV6TGOGX3OHY46GQGPYCTAAK4
# STELLAR_ASSET_SAC=CAS3J7GYLGXMF6TDJBBYYSE3HQ6BBSMLNUQ34T6TZMYMW2EVH34XOWMA
# Same IDs live in the contracts repo addresses.mainnet.json and in
# render.yaml. The public RPC above is rate-limited — use a
# dedicated provider (Validation Cloud, QuickNode, Blockdaemon) at scale.

# Public contract IDs from the testnet deploy (safe to commit).
STELLAR_AGENT_REGISTRY=CAPHXWU53UZUZJGV7IAE57NNMH3YYB5MTWO6YA53KKMXSFVLOITBJ3GQ
STELLAR_REPUTATION_LEDGER=CDCSOBEVZUPQZV5GV4D6KYHZCLNGW2KXY74RUHSZ3EZUXF34DPW422ZT
STELLAR_PAYMENT_ESCROW=CBJPTMAPMGODGZCZ2IMEQSRUX3WGUXNMKDTNN2KMJ3NFGYZ5OJ5525PI
STELLAR_ATTESTATION_REGISTRY=CBYUZKOET43UXTBXZUJIBBJW5ODGD2J2AZVVXCR3QONGOCAHOXQQHEGK
STELLAR_ASSET_SAC=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Backend's signing identity. In prod, set STELLAR_SIGNING_KEY
# (S... secret) via host secrets — NEVER commit.
STELLAR_ADMIN_ADDRESS=GA7AI5TAJEZA27I666DSJC4MUJYBEWUYNNZWPU7R2ONA7IZQVO6R5OQV
STELLAR_SIGNING_KEY=
# Registry sync cadence — on-chain registrations appear in /api/agents within this many seconds
REGISTRY_SYNC_SECONDS=15
# How long the reputation pre-warm waits, in the background, for the sync's first pass (0-60; 0 skips
# the wait). Boot never waits on it; a slower pass carries on in the sync loop.
REGISTRY_BOOT_SYNC_TIMEOUT_SECONDS=5

# ── PDAX (PHP ↔ crypto on/off-ramp, institutions API) ────────
# Environment: production | stage | uat. Base URL is resolved in
# app/pdax/config.py. Staging requires your static IP be whitelisted.
PDAX_ENVIRONMENT=uat
# Account credentials — inject via host secrets in prod, NEVER commit.
PDAX_USERNAME=
PDAX_PASSWORD=
# Base32 TOTP seed — only if the PDAX account has SOFTWARE_TOKEN_MFA.
PDAX_OTP_SECRET=
# Shared secret to validate inbound webhook signatures (optional).
PDAX_WEBHOOK_SECRET=
# Ramp tunables (optional — sensible defaults shown).
PDAX_RAMP_BUFFER_BPS=300
PDAX_RAMP_MIN_PHP=200
PDAX_RAMP_QUOTE_REFERENCE_PHP=1000
# Dev-only escape hatch: accept unsigned webhooks (default false).
PDAX_ALLOW_UNSIGNED_WEBHOOKS=false
# Resilience tunables (optional — sensible defaults shown).
PDAX_MAX_RETRIES=3
PDAX_RATE_LIMIT_PER_SEC=8
PDAX_RATE_LIMIT_BURST=8
